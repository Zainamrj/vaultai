# Runs scripts/eval.mjs as a one-shot container (for a Nebius Serverless Job).
# The eval is standalone: no Next.js. It needs only the `openai` package plus lib/ (prompts, redact, chunk),
# the eval questions and the synthetic test documents.
FROM node:22-alpine
WORKDIR /app

# Install only what the eval needs (keeps the image small and the build fast).
RUN npm install --omit=dev --no-audit --no-fund --no-package-lock --no-save openai@^7.43.0

COPY lib ./lib
COPY scripts/eval.mjs ./scripts/eval.mjs
COPY docs/eval ./docs/eval
COPY docs/test-data ./docs/test-data

# Keys are NOT baked in: pass NEBIUS_API_KEY, NEBIUS_BASE_URL, MODEL_FAST, MODEL_MAIN,
# MODEL_JUDGE and MODEL_EMBED as environment variables when the job starts.
# Results are printed between "----- results.md -----" markers in the job logs.
CMD ["node", "--no-warnings", "scripts/eval.mjs"]
